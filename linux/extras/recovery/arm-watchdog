#!/bin/bash
# Arm a hardware watchdog and make systemd (PID 1) feed it, so a hard hang resets the machine.
# Ubuntu blacklists iTCO_wdt by alias in per-kernel autogenerated files; an explicit modprobe by name
# is not affected. On some Intel boards the TCO timer is created by i2c_i801, so load that first.
# NEVER open /dev/watchdog* from here (opening starts the timer); only read sysfs.
log() { logger -t arm-watchdog "$*"; echo "$*"; }
holds() {
  local fd
  for fd in /proc/1/fd/*; do
    case "$(readlink "$fd" 2>/dev/null)" in /dev/watchdog*) return 0 ;; esac
  done
  return 1
}

if holds; then log "PID 1 already holds a watchdog - nothing to do"; exit 0; fi

modprobe i2c_i801 2>/dev/null
modprobe iTCO_wdt 2>/dev/null
for _ in $(seq 1 20); do [ -e /dev/watchdog0 ] && break; sleep 0.5; done

if [ ! -e /dev/watchdog0 ]; then
  log "no usable hardware watchdog (iTCO_wdt) - falling back to softdog (panic -> kernel.panic reboot)"
  modprobe softdog soft_margin=60 soft_panic=1 2>/dev/null
  for _ in 1 2 3 4 5 6; do [ -e /dev/watchdog0 ] && break; sleep 0.5; done
fi

if [ -e /dev/watchdog0 ]; then
  log "watchdog device: $(cat /sys/class/watchdog/watchdog0/identity 2>/dev/null)"
  systemctl daemon-reexec || true
  sleep 3
  if holds; then log "PID 1 now feeds the watchdog"; else log "WARNING: PID 1 does not hold the watchdog"; fi
else
  log "WARNING: no watchdog available at all"
fi
exit 0
